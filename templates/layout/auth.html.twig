{% extends 'base.html.twig' %}

{% block body %}
    <div class="auth">
        <aside class="auth__brand">
            <div class="auth__staff" aria-hidden="true"></div>
            <span class="auth__note" style="top: 22%; left: 12%;" aria-hidden="true">♪</span>
            <span class="auth__note" style="top: 48%; right: 16%;" aria-hidden="true">♫</span>
            <span class="auth__note" style="bottom: 24%; left: 30%;" aria-hidden="true">♬</span>

            <a class="auth__logo" href="{{ path('app_home') }}">
                <span class="auth__logo-glyph" aria-hidden="true">♪</span>
                petSymphony
            </a>

            <div class="auth__pitch">
                <p class="auth__pitch-title">CRM, в которой каждый клиент звучит <em>в унисон</em> с вами.</p>
                <p class="auth__pitch-sub">
                    Клиенты, заметки и роли команды — партитура вашего бизнеса
                    в одном месте.
                </p>
            </div>

            <p class="auth__footer">petSymphony · учебный проект на Symfony 8 + React</p>
        </aside>

        <main class="auth__main">
            <div class="auth__toggles">
                <button
                    type="button"
                    class="theme-toggle"
                    data-controller="theme"
                    data-action="theme#toggle"
                    aria-label="Переключить тему"
                    title="Светлая / тёмная тема"
                >
                    <span class="theme-toggle__sun" aria-hidden="true">☀</span>
                    <span class="theme-toggle__moon" aria-hidden="true">☾</span>
                </button>
                <button
                    type="button"
                    class="theme-toggle sound-toggle"
                    data-controller="sound"
                    data-action="sound#toggle"
                    aria-label="Звуки интерфейса"
                    title="Звуки интерфейса (по умолчанию выключены)"
                >
                    <span class="sound-toggle__on" aria-hidden="true">🔔</span>
                    <span class="sound-toggle__off" aria-hidden="true">🔕</span>
                </button>
            </div>
            <div class="auth-form">
                {% block auth_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
