{% extends 'base.html.twig' %}

{% block body %}
    <div class="auth">
        <aside class="auth__brand">
            <div class="auth__staff" aria-hidden="true"></div>
            <span class="auth__note" style="top: 22%; left: 12%;" aria-hidden="true">♪</span>
            <span class="auth__note" style="top: 48%; right: 16%;" aria-hidden="true">♫</span>
            <span class="auth__note" style="bottom: 24%; left: 30%;" aria-hidden="true">♬</span>

            <a class="auth__logo" href="{{ path('app_home') }}">
                <span class="auth__logo-glyph" aria-hidden="true">♪</span>
                petSymphony
            </a>

            <div class="auth__pitch">
                {# Ключ содержит статическую разметку (<em>) из каталога — raw безопасен #}
                <p class="auth__pitch-title">{{ 'layout.auth.pitch_title'|trans|raw }}</p>
                <p class="auth__pitch-sub">{{ 'layout.auth.pitch_sub'|trans }}</p>
            </div>

            <p class="auth__footer">{{ 'layout.auth.footer'|trans }}</p>
        </aside>

        <main class="auth__main">
            <div class="auth__toggles">
                <form class="locale-switch" method="post" action="{{ path('app_locale_switch') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('switch_locale') }}">
                    <input type="hidden" name="_locale" value="{{ app.request.locale == 'ru' ? 'en' : 'ru' }}">
                    <button
                        type="submit"
                        class="theme-toggle locale-switch__btn"
                        aria-label="{{ 'layout.locale.switch'|trans }}"
                        title="{{ 'layout.locale.switch'|trans }}"
                    >{{ app.request.locale == 'ru' ? 'EN' : 'RU' }}</button>
                </form>
                <button
                    type="button"
                    class="theme-toggle"
                    data-controller="theme"
                    data-action="theme#toggle"
                    aria-label="{{ 'layout.theme.toggle'|trans }}"
                    title="{{ 'layout.theme.title'|trans }}"
                >
                    <span class="theme-toggle__sun" aria-hidden="true">☀</span>
                    <span class="theme-toggle__moon" aria-hidden="true">☾</span>
                </button>
                <button
                    type="button"
                    class="theme-toggle sound-toggle"
                    data-controller="sound"
                    data-action="sound#toggle"
                    aria-label="{{ 'layout.sound.toggle'|trans }}"
                    title="{{ 'layout.sound.title'|trans }}"
                >
                    <span class="sound-toggle__on" aria-hidden="true">🔔</span>
                    <span class="sound-toggle__off" aria-hidden="true">🔕</span>
                </button>
            </div>
            <div class="auth-form">
                {% block auth_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
