{% extends 'base.html.twig' %}

{% set current_route = app.request.attributes.get('_route') %}

{% block body %}
    <div class="shell">
        <aside class="sidebar">
            <a class="sidebar__logo" href="{{ path('app_home') }}">
                <span class="sidebar__logo-glyph" aria-hidden="true">♪</span>
                <span class="sidebar__logo-text">petSymphony</span>
            </a>

            <nav class="sidebar__nav" aria-label="Основная навигация">
                <span class="sidebar__section">Обзор</span>
                <a class="sidebar__link{{ current_route == 'app_home' ? ' sidebar__link--active' }}" href="{{ path('app_home') }}">
                    <span class="sidebar__link-icon" aria-hidden="true">◳</span>
                    <span class="sidebar__link-text">Рабочий стол</span>
                </a>
                <a class="sidebar__link{{ current_route in ['app_clients', 'app_client'] ? ' sidebar__link--active' }}" href="{{ path('app_clients') }}">
                    <span class="sidebar__link-icon" aria-hidden="true">♩</span>
                    <span class="sidebar__link-text">Ученики</span>
                </a>
                <a class="sidebar__link{{ current_route == 'app_schedule' ? ' sidebar__link--active' }}" href="{{ path('app_schedule') }}">
                    <span class="sidebar__link-icon" aria-hidden="true">🗓</span>
                    <span class="sidebar__link-text">Расписание</span>
                </a>
                <a class="sidebar__link{{ current_route in ['app_events', 'app_event'] ? ' sidebar__link--active' }}" href="{{ path('app_events') }}">
                    <span class="sidebar__link-icon" aria-hidden="true">🎼</span>
                    <span class="sidebar__link-text">Мероприятия</span>
                </a>

                <span class="sidebar__section">Оркестр</span>
                <a class="sidebar__link{{ current_route == 'app_projects' ? ' sidebar__link--active' }}" href="{{ path('app_projects') }}">
                    <span class="sidebar__link-icon" aria-hidden="true">♫</span>
                    <span class="sidebar__link-text">Проекты</span>
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                    <span class="sidebar__section">Администрирование</span>
                    <a class="sidebar__link{{ current_route == 'app_admin_users' ? ' sidebar__link--active' }}" href="{{ path('app_admin_users') }}">
                        <span class="sidebar__link-icon" aria-hidden="true">♯</span>
                        <span class="sidebar__link-text">Пользователи и роли</span>
                    </a>
                    <a class="sidebar__link{{ current_route == 'app_admin_instruments' ? ' sidebar__link--active' }}" href="{{ path('app_admin_instruments') }}">
                        <span class="sidebar__link-icon" aria-hidden="true">🎹</span>
                        <span class="sidebar__link-text">Инструменты</span>
                    </a>
                    <a class="sidebar__link{{ current_route == 'app_styleguide' ? ' sidebar__link--active' }}" href="{{ path('app_styleguide') }}">
                        <span class="sidebar__link-icon" aria-hidden="true">𝄞</span>
                        <span class="sidebar__link-text">Стайлгайд</span>
                    </a>
                {% endif %}
            </nav>

            <div class="sidebar__spacer"></div>

            <div class="sidebar__user">
                <span class="sidebar__avatar" aria-hidden="true">{{ app.user.userIdentifier|slice(0, 2) }}</span>
                <span class="sidebar__user-meta">
                    <span class="sidebar__user-email" title="{{ app.user.userIdentifier }}">{{ app.user.userIdentifier }}</span>
                    <a class="sidebar__logout" href="{{ path('app_logout') }}">Выйти ↗</a>
                </span>
            </div>
        </aside>

        <div class="shell__main">
            <header class="topbar">
                <h1 class="topbar__title">{% block page_title %}{% endblock %}</h1>
                <span class="topbar__hint">{% block page_hint %}{% endblock %}</span>
                <button type="button" class="topbar__search" data-palette-trigger aria-label="Поиск (Ctrl+K)">
                    <span aria-hidden="true">⌕</span>
                    <span class="topbar__search-label">Поиск</span>
                    <kbd>Ctrl K</kbd>
                </button>
                <button
                    type="button"
                    class="theme-toggle"
                    data-controller="theme"
                    data-action="theme#toggle"
                    aria-label="Переключить тему"
                    title="Светлая / тёмная тема"
                >
                    <span class="theme-toggle__sun" aria-hidden="true">☀</span>
                    <span class="theme-toggle__moon" aria-hidden="true">☾</span>
                </button>
                <button
                    type="button"
                    class="theme-toggle sound-toggle"
                    data-controller="sound"
                    data-action="sound#toggle"
                    aria-label="Звуки интерфейса"
                    title="Звуки интерфейса (по умолчанию выключены)"
                >
                    <span class="sound-toggle__on" aria-hidden="true">🔔</span>
                    <span class="sound-toggle__off" aria-hidden="true">🔕</span>
                </button>
            </header>
            <main class="shell__content">
                {% block content %}{% endblock %}
            </main>
        </div>

        <div {{ react_component('SearchPalette', { clientsBasePath: path('app_clients') }) }}></div>
    </div>
{% endblock %}
