{% extends 'base.html.twig' %}

{% block title %}{{ 'crm.landing.meta.title'|trans }}{% endblock %}

{% block stylesheets %}
    <meta name="description" content="{{ 'crm.landing.meta.description'|trans }}">
    <meta property="og:title" content="{{ 'crm.landing.meta.title'|trans }}">
    <meta property="og:description" content="{{ 'crm.landing.meta.og_description'|trans }}">
    <meta property="og:type" content="website">
    <meta property="og:image" content="{{ absolute_url(asset('og-image.png')) }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    {{ parent() }}
{% endblock %}

{% block body %}
<div class="landing">
    <header class="landing__topbar">
        <a class="landing__logo" href="{{ path('app_home') }}">
            <span aria-hidden="true">♪</span> petSymphony
        </a>
        <nav class="landing__nav" aria-label="{{ 'crm.landing.nav.aria'|trans }}">
            {% include '_partials/locale_switch.html.twig' %}
            <button
                type="button"
                class="theme-toggle"
                data-controller="theme"
                data-action="theme#toggle"
                aria-label="{{ 'crm.landing.theme_toggle.aria'|trans }}"
            >
                <span class="theme-toggle__sun" aria-hidden="true">☀</span>
                <span class="theme-toggle__moon" aria-hidden="true">☾</span>
            </button>
            <a class="btn btn--ghost btn--sm" href="{{ path('app_login') }}">{{ 'crm.landing.nav.login'|trans }}</a>
            <a class="btn btn--brass btn--sm" href="{{ path('app_register') }}">{{ 'crm.landing.nav.start'|trans }}</a>
        </nav>
    </header>

    <main>
        <section class="landing__hero">
            <div class="landing__staff" aria-hidden="true"></div>
            <p class="landing__eyebrow">{{ 'crm.landing.hero.eyebrow'|trans }}</p>
            <h1 class="landing__title">
                {{ 'crm.landing.hero.title'|trans|raw }}
            </h1>
            <p class="landing__sub">
                {{ 'crm.landing.hero.sub'|trans }}
            </p>
            <div class="landing__cta">
                <a class="btn btn--brass" href="{{ path('app_register') }}">{{ 'crm.landing.hero.cta_primary'|trans }}</a>
                <a class="btn btn--ghost" href="{{ path('app_login') }}">{{ 'crm.landing.hero.cta_secondary'|trans }}</a>
            </div>
        </section>

        <section class="landing__features" aria-label="{{ 'crm.landing.features.aria'|trans }}">
            <div class="landing__feature">
                <span class="landing__feature-icon" aria-hidden="true">♩</span>
                <h2 class="landing__feature-title">{{ 'crm.landing.features.students.title'|trans }}</h2>
                <p class="landing__feature-text">
                    {{ 'crm.landing.features.students.text'|trans }}
                </p>
            </div>
            <div class="landing__feature">
                <span class="landing__feature-icon" aria-hidden="true">🗓</span>
                <h2 class="landing__feature-title">{{ 'crm.landing.features.schedule.title'|trans }}</h2>
                <p class="landing__feature-text">
                    {{ 'crm.landing.features.schedule.text'|trans }}
                </p>
            </div>
            <div class="landing__feature">
                <span class="landing__feature-icon" aria-hidden="true">𝄞</span>
                <h2 class="landing__feature-title">{{ 'crm.landing.features.repertoire.title'|trans }}</h2>
                <p class="landing__feature-text">
                    {{ 'crm.landing.features.repertoire.text'|trans }}
                </p>
            </div>
            <div class="landing__feature">
                <span class="landing__feature-icon" aria-hidden="true">🎼</span>
                <h2 class="landing__feature-title">{{ 'crm.landing.features.concerts.title'|trans }}</h2>
                <p class="landing__feature-text">
                    {{ 'crm.landing.features.concerts.text'|trans }}
                </p>
            </div>
        </section>

        <section class="landing__attention">
            <p class="landing__attention-text">
                <span aria-hidden="true">⚠</span> {{ 'crm.landing.attention.text'|trans }}
            </p>
        </section>
    </main>

    <footer class="landing__footer">
        <span aria-hidden="true">♪</span> petSymphony · {{ 'crm.landing.footer.text'|trans }}
    </footer>
</div>
{% endblock %}
