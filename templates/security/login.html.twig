{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'page.login.title'|trans }}{% endblock %}

{% block auth_content %}
    <p class="auth-form__eyebrow">{{ 'page.login.eyebrow'|trans }}</p>
    <h1 class="auth-form__title">{{ 'page.login.heading'|trans }}</h1>
    <p class="auth-form__sub">{{ 'page.login.sub'|trans }}</p>

    {% if app.request.query.get('registered') %}
        <div class="alert alert--success auth-form__alert" role="status">
            <span aria-hidden="true">✓</span>
            <div>{{ 'page.login.registered'|trans }}</div>
        </div>
    {% endif %}

    {% if app.request.query.get('expired') %}
        <div class="alert alert--error auth-form__alert" role="status">
            <span aria-hidden="true">♪</span>
            <div>{{ 'page.login.expired'|trans }}</div>
        </div>
    {% endif %}

    {% if prefillEmail is defined and prefillEmail %}
        <div class="alert alert--success auth-form__alert" role="status">
            <span aria-hidden="true">♮</span>
            <div>{{ 'page.login.reauth'|trans }}</div>
        </div>
    {% endif %}

    <div class="auth-form__body" {{ react_component('LoginForm', {
        csrfToken: csrf_token('authenticate'),
        loginUrl: path('api_login'),
        redirectUrl: (targetPath is defined and targetPath) ? targetPath : path('app_home'),
        prefillEmail: (prefillEmail is defined and prefillEmail) ? prefillEmail : null
    }) }}></div>

    <div class="auth-form__links">
        <a href="{{ path('app_forgot_password') }}">{{ 'page.login.forgot'|trans }}</a>
        <a href="{{ path('app_register') }}">{{ 'page.login.create_account'|trans }}</a>
    </div>
{% endblock %}
