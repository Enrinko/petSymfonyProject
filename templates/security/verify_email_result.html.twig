{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'page.verify.title'|trans }}{% endblock %}

{% block auth_content %}
    {% if success %}
        <p class="auth-form__eyebrow">{{ 'page.verify.success_eyebrow'|trans }}</p>
        <h1 class="auth-form__title">{{ 'page.verify.success_heading'|trans }}</h1>
        <p class="auth-form__sub">{{ 'page.verify.success_sub'|trans }}</p>
        <div class="auth-form__actions">
            <a class="btn btn--brass btn--block" href="{{ path('app_home') }}">{{ 'page.verify.go_dashboard'|trans }}</a>
        </div>
    {% else %}
        <p class="auth-form__eyebrow">{{ 'page.verify.fail_eyebrow'|trans }}</p>
        <h1 class="auth-form__title">{{ 'page.verify.fail_heading'|trans }}</h1>
        <div class="alert alert--error auth-form__alert" role="status">
            <span aria-hidden="true">♪</span>
            <div>{{ reason }}</div>
        </div>
        <p class="auth-form__sub">{{ 'page.verify.fail_sub'|trans }}</p>
        <div class="auth-form__actions">
            <a class="btn btn--brass btn--block" href="{{ path('app_login') }}">{{ 'page.verify.login'|trans }}</a>
        </div>
    {% endif %}
{% endblock %}
