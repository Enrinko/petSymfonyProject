{% extends 'layout/auth.html.twig' %}

{% block title %}Новый пароль — petSymphony CRM{% endblock %}

{% block auth_content %}
    <p class="auth-form__eyebrow">Финал</p>
    <h1 class="auth-form__title">Новый пароль</h1>
    <p class="auth-form__sub">Придумайте новый пароль для вашего аккаунта.</p>

    <div class="auth-form__body" {{ react_component('ResetPasswordForm', {
        token: token,
        loginUrl: path('app_login'),
        forgotPasswordUrl: path('app_forgot_password')
    }) }}></div>
{% endblock %}
