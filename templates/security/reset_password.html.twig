{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'page.reset.title'|trans }}{% endblock %}

{% block auth_content %}
    <p class="auth-form__eyebrow">{{ 'page.reset.eyebrow'|trans }}</p>
    <h1 class="auth-form__title">{{ 'page.reset.heading'|trans }}</h1>
    <p class="auth-form__sub">{{ 'page.reset.sub'|trans }}</p>

    <div class="auth-form__body" {{ react_component('ResetPasswordForm', {
        token: token,
        loginUrl: path('app_login'),
        forgotPasswordUrl: path('app_forgot_password')
    }) }}></div>
{% endblock %}
