{% extends 'layout/auth.html.twig' %}

{% block title %}Восстановление пароля — petSymphony CRM{% endblock %}

{% block auth_content %}
    <p class="auth-form__eyebrow">Реприза</p>
    <h1 class="auth-form__title">Забыли пароль?</h1>
    <p class="auth-form__sub">
        Укажите email — пришлём ссылку для сброса. Она будет действовать один час.
    </p>

    <div class="auth-form__body" {{ react_component('ForgotPasswordForm') }}></div>

    <div class="auth-form__links">
        <a href="{{ path('app_login') }}">← Вернуться ко входу</a>
    </div>
{% endblock %}
