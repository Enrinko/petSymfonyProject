{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'page.forgot.title'|trans }}{% endblock %}

{% block auth_content %}
    <p class="auth-form__eyebrow">{{ 'page.forgot.eyebrow'|trans }}</p>
    <h1 class="auth-form__title">{{ 'page.forgot.heading'|trans }}</h1>
    <p class="auth-form__sub">{{ 'page.forgot.sub'|trans }}</p>

    <div class="auth-form__body" {{ react_component('ForgotPasswordForm') }}></div>

    <div class="auth-form__links">
        <a href="{{ path('app_login') }}">{{ 'page.forgot.back'|trans }}</a>
    </div>
{% endblock %}
