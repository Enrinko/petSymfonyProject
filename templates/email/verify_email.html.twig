{% extends 'email/base_email.html.twig' %}

{% block email_title %}Подтвердите email — petSymphony{% endblock %}

{% block email_body %}
    <h1 style="margin:0 0 16px;font-size:22px;color:#23253a;">Добро пожаловать в оркестр!</h1>
    <p style="margin:0 0 12px;font-size:15px;line-height:1.6;color:#6f7288;">
        Остался один шаг: подтвердите, что этот email принадлежит вам.
        Ссылка действует <strong>1&nbsp;час</strong>.
    </p>
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
        <tr>
            <td style="border-radius:10px;background:#9a6b15;">
                <a href="{{ verifyUrl }}" style="display:inline-block;padding:13px 28px;font-size:15px;font-weight:600;color:#fffdf9;text-decoration:none;border-radius:10px;">
                    Подтвердить email
                </a>
            </td>
        </tr>
    </table>
    <p style="margin:0 0 8px;font-size:13px;line-height:1.6;color:#a0a3b8;">
        Если кнопка не работает, скопируйте ссылку в адресную строку браузера:
    </p>
    <p style="margin:0;font-size:13px;line-height:1.6;word-break:break-all;">
        <a href="{{ verifyUrl }}" style="color:#9a6b15;">{{ verifyUrl }}</a>
    </p>
{% endblock %}

{% block email_footer %}
    Если вы не регистрировались в petSymphony — просто проигнорируйте это письмо.
{% endblock %}
