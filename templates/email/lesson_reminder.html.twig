{% extends 'email/base_email.html.twig' %}

{% block email_title %}Напоминание о занятии — petSymphony{% endblock %}

{% block email_body %}
    <h1 style="margin:0 0 16px;font-size:22px;color:#23253a;">Напоминание о занятии</h1>
    <p style="margin:0 0 12px;font-size:15px;line-height:1.6;color:#6f7288;">
        Здравствуйте, {{ lesson.client.name }}!
    </p>
    <p style="margin:0 0 12px;font-size:15px;line-height:1.6;color:#23253a;">
        Напоминаем: <strong>{{ lesson.startsAt|date('d.m.Y') }} в {{ lesson.startsAt|date('H:i') }}</strong>
        у вас занятие{% if lesson.instrument %} — {{ lesson.instrument.name|lower }}{% endif %}
        ({{ lesson.durationMinutes }} мин).
    </p>
    {% if lesson.comment %}
        <p style="margin:0 0 4px;font-size:14px;line-height:1.6;color:#6f7288;border-left:3px solid #c8902c;padding-left:12px;">
            Комментарий преподавателя: {{ lesson.comment }}
        </p>
    {% endif %}
{% endblock %}

{% block email_footer %}
    Если планы поменялись — предупредите преподавателя заранее.
{% endblock %}
