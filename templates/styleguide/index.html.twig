{% extends 'layout/shell.html.twig' %}

{% block title %}{{ 'crm.styleguide.meta_title'|trans }}{% endblock %}

{% block page_title %}{{ 'crm.styleguide.page_title'|trans }}{% endblock %}
{% block page_hint %}{{ 'crm.styleguide.page_hint'|trans }}{% endblock %}

{% block content %}
<div class="sg">

    <section class="sg__section">
        <h2 class="sg__title">{{ 'crm.styleguide.palette_title'|trans }}</h2>
        <p class="sg__hint">{{ 'crm.styleguide.palette_hint'|trans|raw }}</p>
        {% for group, tokens in palette %}
            <h3 class="sg__subtitle">{{ group }}</h3>
            <div class="sg__swatches">
                {% for token in tokens %}
                    <div class="sg__swatch">
                        <span class="sg__swatch-color" style="background: var({{ token }})"></span>
                        <code>{{ token }}</code>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </section>

    <section class="sg__section">
        <h2 class="sg__title">{{ 'crm.styleguide.buttons_title'|trans }}</h2>
        <p class="sg__hint">{{ 'crm.styleguide.buttons_rule'|trans|raw }}</p>
        <div class="sg__row">
            <button class="btn btn--primary" type="button">Primary</button>
            <button class="btn btn--brass" type="button">{{ 'crm.styleguide.btn_brass'|trans }}</button>
            <button class="btn btn--ghost" type="button">Ghost</button>
            <button class="btn btn--brass btn--sm" type="button">Small</button>
            <button class="btn btn--primary" type="button" disabled>Disabled</button>
            <button class="btn btn--brass" type="button">
                <span class="btn__metronome" aria-hidden="true"></span> Loading…
            </button>
        </div>
        <div class="sg__row">
            <button class="btn btn--brass btn--block" type="button">{{ 'crm.styleguide.btn_block'|trans }}</button>
        </div>
    </section>

    <section class="sg__section">
        <h2 class="sg__title">{{ 'crm.styleguide.fields_title'|trans }}</h2>
        <div class="sg__grid">
            <div class="field">
                <label class="field__label" for="sg-f1">{{ 'crm.styleguide.field_normal'|trans }}</label>
                <input class="field__input" id="sg-f1" placeholder="{{ 'crm.styleguide.placeholder'|trans }}">
            </div>
            <div class="field">
                <label class="field__label" for="sg-f2">{{ 'crm.styleguide.field_error'|trans }}</label>
                <input class="field__input field__input--invalid" id="sg-f2" value="{{ 'crm.styleguide.error_value'|trans }}" aria-invalid="true" aria-describedby="sg-f2-err">
                <span class="field__error" id="sg-f2-err">{{ 'crm.styleguide.error_text'|trans }}</span>
            </div>
            <div class="field">
                <label class="field__label" for="sg-f3">{{ 'crm.styleguide.field_select'|trans }}</label>
                <select class="field__input" id="sg-f3"><option>{{ 'crm.styleguide.select_option'|trans }}</option></select>
            </div>
        </div>
    </section>

    <section class="sg__section">
        <h2 class="sg__title">{{ 'crm.styleguide.alerts_title'|trans }}</h2>
        <p class="sg__hint">{{ 'crm.styleguide.alerts_a11y'|trans|raw }}</p>
        <div class="sg__stack">
            <div class="alert alert--success" role="status"><span aria-hidden="true">✓</span><div>{{ 'crm.styleguide.alert_success'|trans }}</div></div>
            <div class="alert alert--error" role="alert"><span aria-hidden="true">♪</span><div>{{ 'crm.styleguide.alert_error'|trans }}</div></div>
        </div>
    </section>

    <section class="sg__section">
        <h2 class="sg__title">{{ 'crm.styleguide.chips_title'|trans }}</h2>
        <h3 class="sg__subtitle">{{ 'crm.styleguide.roles_subtitle'|trans }}</h3>
        <div class="sg__row">
            <span class="chip chip--admin">{{ 'crm.styleguide.role_admin'|trans }}</span>
            <span class="chip chip--mod">{{ 'crm.styleguide.role_mod'|trans }}</span>
            <span class="chip chip--user">{{ 'crm.styleguide.role_user'|trans }}</span>
        </div>
        <h3 class="sg__subtitle">{{ 'crm.styleguide.tags_subtitle'|trans }}</h3>
        <div class="sg__row">
            {% for i in 0..7 %}
                <span class="tag-chip tag-chip--c{{ i }}">{{ 'crm.styleguide.tag_label'|trans({'%n%': i}) }}</span>
            {% endfor %}
        </div>
        <h3 class="sg__subtitle">{{ 'crm.styleguide.chips_subtitle2'|trans }}</h3>
        <div class="sg__row">
            <span class="instrument-chip">🎹 {{ 'crm.styleguide.instrument_piano'|trans }}</span>
            <span class="instrument-chip instrument-chip--on">✓ {{ 'crm.styleguide.instrument_vocal'|trans }}</span>
            <span class="piece-badge piece-badge--learning">{{ 'crm.styleguide.piece_learning'|trans }}</span>
            <span class="piece-badge piece-badge--memorizing">{{ 'crm.styleguide.piece_memorizing'|trans }}</span>
            <span class="piece-badge piece-badge--ready">{{ 'crm.styleguide.piece_ready'|trans }}</span>
            <span class="piece-badge piece-badge--done">{{ 'crm.styleguide.piece_done'|trans }}</span>
        </div>
        <div class="sg__row">
            <span class="att-dot att-dot--ok" title="{{ 'crm.styleguide.att_ok'|trans }}"></span>
            <span class="att-dot att-dot--miss" title="{{ 'crm.styleguide.att_miss'|trans }}"></span>
            <span class="att-dot att-dot--cancel" title="{{ 'crm.styleguide.att_cancel'|trans }}"></span>
            <span class="badge">{{ 'crm.styleguide.badge_archive'|trans }}</span>
            <span class="badge att__warn">⚠ {{ 'crm.styleguide.badge_attention'|trans }}</span>
        </div>
    </section>

    <section class="sg__section">
        <h2 class="sg__title">{{ 'crm.styleguide.card_title'|trans }}</h2>
        <div class="sg__grid">
            <div class="card">
                <div class="card__header"><h3 class="card__title">{{ 'crm.styleguide.card_header'|trans }}</h3></div>
                <div class="card__body">{{ 'crm.styleguide.card_body'|trans|raw }}</div>
            </div>
            <div class="card">
                <div class="card__body">
                    <div class="clients__empty">
                        <span class="clients__empty-glyph" aria-hidden="true">♪</span>
                        {{ 'crm.styleguide.empty_canon'|trans }}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="sg__section">
        <h2 class="sg__title">{{ 'crm.styleguide.typo_title'|trans }}</h2>
        <div class="sg__stack">
            <p style="font-family: var(--font-display); font-size: 22px;">{{ 'crm.styleguide.typo_display'|trans }}</p>
            <p style="font-family: var(--font-ui);">{{ 'crm.styleguide.typo_ui'|trans }}</p>
            <p style="font-family: var(--font-mono);">{{ 'crm.styleguide.typo_mono'|trans }}</p>
        </div>
        <div class="sg__row">
            <span class="sg__fx" style="border-radius: var(--radius-sm); box-shadow: var(--shadow-sm);">radius-sm + shadow-sm</span>
            <span class="sg__fx" style="border-radius: var(--radius-md); box-shadow: var(--shadow-md);">radius-md + shadow-md</span>
            <span class="sg__fx" style="border-radius: var(--radius-lg); box-shadow: var(--shadow-brass);">radius-lg + shadow-brass</span>
        </div>
    </section>

</div>
{% endblock %}
