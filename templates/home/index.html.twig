{% extends 'layout/shell.html.twig' %}

{% block title %}{{ 'crm.home.title'|trans }}{% endblock %}

{% block page_title %}{{ 'crm.home.page_title'|trans }}{% endblock %}
{% block page_hint %}{{ 'now'|date('d.m.Y') }}{% endblock %}

{% block content %}
    <div class="dash">
        <section class="dash__hero">
            <p class="dash__hero-eyebrow">{{ 'crm.home.hero.eyebrow'|trans }}</p>
            <h2 class="dash__hero-title">{{ 'crm.home.hero.greeting'|trans({'%name%': app.user.displayName ?: app.user.userIdentifier|split('@')|first}) }}</h2>
            <p class="dash__hero-sub">
                {{ 'crm.home.hero.sub'|trans }}
            </p>
        </section>

        <div {{ react_component('Dashboard', { clientsPath: path('app_clients') }) }}></div>
    </div>
{% endblock %}
