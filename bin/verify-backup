#!/bin/sh
# Проверка восстановимости бэкапа: разворачивает дамп во ВРЕМЕННЫЙ
# postgres-контейнер и делает smoke-запросы. Непроверенный бэкап
# равен отсутствующему — гонять не реже раза в месяц.
#
#   sh bin/verify-backup <файл.dump>
#   sh bin/verify-backup            # последний из volume бэкапов prod-стека
set -eu

DUMP="${1:-}"
VOLUME="${BACKUP_VOLUME:-petsymphony_backups_data}"
CONTAINER="psy-backup-verify-$$"

cleanup() { docker rm -f "$CONTAINER" >/dev/null 2>&1 || true; }
trap cleanup EXIT INT TERM

if [ -z "$DUMP" ]; then
    DUMP=$(docker run --rm -v "$VOLUME:/backups:ro" postgres:16-alpine \
        sh -c 'ls -1 /backups/daily/*.dump 2>/dev/null | sort | tail -1') || true
    [ -n "$DUMP" ] || { echo "Дампов в volume $VOLUME нет"; exit 1; }
    echo "Проверяю последний дамп из volume: $DUMP"
    MOUNT="-v $VOLUME:/backups:ro"
else
    [ -f "$DUMP" ] || { echo "Файл не найден: $DUMP"; exit 1; }
    HOST_DIR=$(cd "$(dirname "$DUMP")" && pwd)
    MOUNT="-v $HOST_DIR:/backups:ro"
    DUMP="/backups/$(basename "$DUMP")"
fi

echo "1/3 Поднимаю временный PostgreSQL..."
# shellcheck disable=SC2086
docker run -d --name "$CONTAINER" -e POSTGRES_PASSWORD=verify -e POSTGRES_DB=verify $MOUNT postgres:16-alpine >/dev/null

n=0
until docker exec "$CONTAINER" pg_isready -U postgres -q 2>/dev/null; do
    n=$((n + 1)); [ "$n" -lt 60 ] || { echo "PostgreSQL не поднялся"; exit 1; }
    sleep 1
done

echo "2/3 Восстанавливаю $DUMP..."
docker exec "$CONTAINER" pg_restore -U postgres -d verify --no-owner --no-privileges "$DUMP"

echo "3/3 Smoke-запросы:"
docker exec "$CONTAINER" psql -U postgres -d verify -t -A -c \
    "SELECT 'users: ' || count(*) FROM \"user\" UNION ALL SELECT 'clients: ' || count(*) FROM client UNION ALL SELECT 'tables: ' || count(*) FROM information_schema.tables WHERE table_schema = 'public'"

echo "OK: бэкап восстановим."
