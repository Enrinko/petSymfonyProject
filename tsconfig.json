{
    "compilerOptions": {
        "sourceMap": true,
        "moduleResolution": "node",
        "lib": ["dom", "dom.iterable", "es2019"],
        "jsx": "react-jsx",
        "target": "es6",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["assets/**/*.ts", "assets/**/*.tsx"]
}
